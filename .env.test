# .env.test

DATABASE_URL="postgresql://testuser:testpass@localhost:5432/testdb?schema=public"

# redis数据库配置
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=
REDIS_DB=0

# Auth Secret
AUTH_SECRET="test-secret-do-not-use-in-production-please-change-me"
# Auth URL
AUTH_URL=http://localhost:3000

# JWT有效期, 单位:s, 默认7天
SESSION_MAX_AGE=604800

# 邮件配置 (本地开发用 MailPit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost